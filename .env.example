# 이 파일을 .env 로 복사한 뒤 값을 입력하세요. (.env 는 GitHub 에 올리지 않습니다)
# Streamlit Cloud 배포 시에는 App settings → Secrets 에 같은 키를 등록합니다.

OPENAI_API_KEY=sk-your-key-here

# 조체선료 분석 모델 ID (fine-tuned 모델이면 ft:... 형식 그대로 입력)
OPENAI_MODEL=gpt-4o

# 스캔본/이미지 SOF 판독용 (비전 지원 모델). 비우면 OPENAI_MODEL 사용
OPENAI_VISION_MODEL=gpt-4o

# (선택) 앱 접속 비밀번호. 비우면 비밀번호 없이 접속
APP_PASSWORD=
